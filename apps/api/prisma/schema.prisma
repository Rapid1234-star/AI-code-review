generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  name               String
  fallbackProviderId String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  projects           Project[]
  providers          AiProvider[] @relation("OwnedProviders")
  fallbackProvider   AiProvider?  @relation("FallbackProvider", fields: [fallbackProviderId], references: [id], onDelete: SetNull)
}

model Project {
  id          String             @id @default(cuid())
  userId      String
  name        String
  description String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  reviews     Review[]
  github      GithubRepository?
  testRuns    TestRun[]
  reports     Report[]
  tests       GeneratedTest[]
  chats       ChatSession[]

  @@index([userId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  language  String
  content   String
  sizeBytes Int
  lineCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

model Review {
  id              String     @id @default(cuid())
  projectId       String
  mode            ReviewMode
  summary         String
  recommendations Json
  providerName    String?
  usedFallback    Boolean    @default(false)
  createdAt       DateTime   @default(now())
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues          ReviewIssue[]

  @@index([projectId])
  @@index([createdAt])
}

model ReviewIssue {
  id             String   @id @default(cuid())
  reviewId       String
  title          String
  severity       Severity
  file           String
  line           Int?
  description    String
  recommendation String
  confidence     Float
  review         Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([severity])
}

model AiProvider {
  id             String   @id @default(cuid())
  userId         String
  name           String
  providerType   String
  baseUrl        String
  apiKeyCipher   String
  apiKeyLastFour String
  model          String
  enabled        Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation("OwnedProviders", fields: [userId], references: [id], onDelete: Cascade)
  fallbackFor    User?    @relation("FallbackProvider")

  @@index([userId])
}

model GithubRepository {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  owner               String
  repo                String
  url                 String
  branch              String   @default("main")
  lastSeenSha         String?
  continuousTesting   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([owner, repo])
}

model GeneratedTest {
  id         String   @id @default(cuid())
  projectId  String
  sourcePath String
  testPath   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, testPath])
  @@index([projectId])
}

model TestRun {
  id            String       @id @default(cuid())
  projectId     String
  number        Int
  commitSha     String?
  branch        String?
  status        TestStatus
  trigger       String
  durationMs    Int?
  changedFiles  Json?
  providerName  String?
  usedFallback  Boolean      @default(false)
  errorMessage  String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results       TestResult[]
  report        Report?

  @@unique([projectId, number])
  @@index([projectId])
  @@index([startedAt])
}

model TestResult {
  id                 String   @id @default(cuid())
  testRunId          String
  name               String
  file               String
  status             String
  durationMs         Int?
  error              String?
  stack              String?
  aiAnalysis         String?
  aiRecommendation   String?
  aiAffectedFile     String?
  testRun            TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([testRunId])
}

model Report {
  id        String   @id @default(cuid())
  projectId String
  testRunId String   @unique
  html      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRun   TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ChatSession {
  id        String        @id @default(cuid())
  projectId String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([projectId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ReviewMode {
  security
  performance
  quality
}

enum Severity {
  critical
  high
  medium
  low
}

enum TestStatus {
  running
  passed
  failed
  error
}
